# Generated by scripts/probe-build-docker.mjs — .env.local with the quotes
# stripped, because `docker run --env-file` is not dotenv and ships surrounding
# quotes through verbatim. It carries the SAME live secrets, and it is matched by
# none of the patterns above: `.env` is an exact name and `.env*.local` needs the
# .local suffix. Must be listed explicitly or it is one `git add` from publishing
# every key.
.env.docker-probe
!.env.example

