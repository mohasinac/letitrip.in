{
  "extends": "@mohasinac/appkit/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    // Override appkit/tsconfig.base.json's beyond-strict flags for the consumer
    // app specifically. Enabling all 5 here (which also compiles appkit/src as
    // project files, see include[] below) surfaced ~4,900 new errors dominated
    // by exactOptionalPropertyTypes + noPropertyAccessFromIndexSignature across
    // this 3,400+ file app's checkout/cart/Firebase-init code. Retrofitting that
    // safely is its own multi-day project, not something to rush through under
    // time pressure on revenue-critical paths right before a production reset +
    // deploy. noImplicitOverride and noFallthroughCasesInSwitch stay on — far
    // smaller, purely-additive/mechanical fallout, fixed directly instead.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "appkit/src/**/*.ts",
    "appkit/src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "functions",
    "scripts",
    "src/**/__tests__/**",
    "appkit/src/**/__tests__/**"
  ]
}
