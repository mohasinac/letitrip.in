{
  "extends": "@mohasinac/appkit/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@mohasinac/appkit": ["./appkit/src/server-entry.ts", "./node_modules/@mohasinac/appkit/dist/server-entry.d.ts"],
      "@mohasinac/appkit/client": ["./appkit/src/client.ts", "./node_modules/@mohasinac/appkit/dist/client.d.ts"],
      "@mohasinac/appkit/server": ["./appkit/src/server.ts", "./node_modules/@mohasinac/appkit/dist/server.d.ts"],
      "@mohasinac/appkit/ui": ["./appkit/src/ui/index.ts", "./node_modules/@mohasinac/appkit/dist/ui/index.d.ts"],
      "@mohasinac/appkit/next": ["./appkit/src/next/index.ts", "./node_modules/@mohasinac/appkit/dist/next/index.d.ts"],
      "@mohasinac/appkit/jobs": ["./appkit/src/jobs.ts", "./node_modules/@mohasinac/appkit/dist/jobs.d.ts"],
      "@mohasinac/appkit/providers": ["./appkit/src/providers.ts", "./node_modules/@mohasinac/appkit/dist/providers.d.ts"],
      "@mohasinac/appkit/providers/auth-firebase": ["./appkit/src/providers/auth-firebase/index.ts", "./node_modules/@mohasinac/appkit/dist/providers/auth-firebase/index.d.ts"],
      "@mohasinac/appkit/providers/db-firebase": ["./appkit/src/providers/db-firebase/index.ts", "./node_modules/@mohasinac/appkit/dist/providers/db-firebase/index.d.ts"],
      "@mohasinac/appkit/providers/email-resend": ["./appkit/src/providers/email-resend/index.ts", "./node_modules/@mohasinac/appkit/dist/providers/email-resend/index.d.ts"],
      "@mohasinac/appkit/providers/storage-firebase": ["./appkit/src/providers/storage-firebase/index.ts", "./node_modules/@mohasinac/appkit/dist/providers/storage-firebase/index.d.ts"],
      "@mohasinac/appkit/instrumentation": ["./appkit/src/instrumentation/index.ts", "./node_modules/@mohasinac/appkit/dist/instrumentation/index.d.ts"],
      "@mohasinac/appkit/contracts/registry": ["./appkit/src/contracts/registry.ts", "./node_modules/@mohasinac/appkit/dist/contracts/registry.d.ts"],
      "@mohasinac/appkit/core/baseline-resolver": ["./appkit/src/core/baseline-resolver.ts", "./node_modules/@mohasinac/appkit/dist/core/baseline-resolver.d.ts"],
      "@mohasinac/appkit/style/tailwind": ["./appkit/src/style/tailwind/index.ts", "./node_modules/@mohasinac/appkit/dist/style/tailwind/index.d.ts"],
      "@mohasinac/appkit/repositories/site-settings": ["./appkit/src/features/admin/repository/site-settings.repository.ts", "./node_modules/@mohasinac/appkit/dist/features/admin/repository/site-settings.repository.d.ts"],
      "@mohasinac/appkit/features/events": ["./appkit/src/features/events/index.ts", "./node_modules/@mohasinac/appkit/dist/features/events/index.d.ts"],
      "@mohasinac/appkit/features/whatsapp-bot/server": ["./appkit/src/features/whatsapp-bot/server.ts", "./node_modules/@mohasinac/appkit/dist/features/whatsapp-bot/server.d.ts"],
      "@mohasinac/appkit/tokens": ["./appkit/src/tokens/index.ts", "./node_modules/@mohasinac/appkit/dist/tokens/index.d.ts"],
      "@mohasinac/appkit/tokens/*": ["./appkit/src/tokens/*", "./node_modules/@mohasinac/appkit/dist/tokens/*"],
      "@mohasinac/appkit/messages/*": ["./appkit/src/features/*/messages/en.json"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "appkit/src/**/*.ts",
    "appkit/src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "functions",
    "scripts"
  ]
}
