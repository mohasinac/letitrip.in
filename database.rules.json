{
  "rules": {
    ".read": false,
    ".write": false,
    "auction-bids": {
      "$productId": {
        ".read": false,
        ".write": false,
        ".validate": "newData.hasChildren(['currentBid', 'bidCount'])",
        "currentBid": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "bidCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() || newData.val() == '.sv'"
        },
        "lastBid": {
          "amount": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "bidderName": {
            ".validate": "newData.isString()"
          },
          "timestamp": {
            ".validate": "newData.isNumber() || newData.val() == '.sv'"
          }
        }
      }
    },
    "auth_events": {
      "$eventId": {
        ".read": "auth != null && auth.token.authEventId == $eventId",
        ".write": false
      }
    },
    "payment_events": {
      "$eventId": {
        ".read": "auth != null && auth.token.paymentEventId == $eventId",
        ".write": false
      }
    },
    "bulk_events": {
      "$jobId": {
        ".read": "auth != null && auth.token.bulkJobId == $jobId",
        ".write": false
      }
    }
  }
}
