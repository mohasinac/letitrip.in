{
  "extends": "@mohasinac/appkit/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@mohasinac/appkit": ["./node_modules/@mohasinac/appkit/dist/server-entry.js"],
      "@mohasinac/appkit/client": ["./node_modules/@mohasinac/appkit/dist/client.js"],
      "@mohasinac/appkit/server": ["./node_modules/@mohasinac/appkit/dist/server.js"],
      "@mohasinac/appkit/ui": ["./node_modules/@mohasinac/appkit/dist/ui/index.js"],
      "@mohasinac/appkit/next": ["./node_modules/@mohasinac/appkit/dist/next/index.js"],
      "@mohasinac/appkit/jobs": ["./node_modules/@mohasinac/appkit/dist/jobs.js"],
      "@mohasinac/appkit/providers": ["./node_modules/@mohasinac/appkit/dist/providers.js"],
      "@mohasinac/appkit/providers/auth-firebase": ["./node_modules/@mohasinac/appkit/dist/providers/auth-firebase/index.js"],
      "@mohasinac/appkit/providers/db-firebase": ["./node_modules/@mohasinac/appkit/dist/providers/db-firebase/index.js"],
      "@mohasinac/appkit/providers/email-resend": ["./node_modules/@mohasinac/appkit/dist/providers/email-resend/index.js"],
      "@mohasinac/appkit/providers/storage-firebase": ["./node_modules/@mohasinac/appkit/dist/providers/storage-firebase/index.js"],
      "@mohasinac/appkit/instrumentation": ["./node_modules/@mohasinac/appkit/dist/instrumentation/index.js"],
      "@mohasinac/appkit/contracts/registry": ["./node_modules/@mohasinac/appkit/dist/contracts/registry.js"],
      "@mohasinac/appkit/core/baseline-resolver": ["./node_modules/@mohasinac/appkit/dist/core/baseline-resolver.js"],
      "@mohasinac/appkit/style/tailwind": ["./node_modules/@mohasinac/appkit/dist/style/tailwind/index.js"],
      "@mohasinac/appkit/repositories/site-settings": ["./node_modules/@mohasinac/appkit/dist/features/admin/repository/site-settings.repository.js"],
      "@mohasinac/appkit/features/events": ["./node_modules/@mohasinac/appkit/dist/features/events/index.js"],
      "@mohasinac/appkit/features/whatsapp-bot/server": ["./node_modules/@mohasinac/appkit/dist/features/whatsapp-bot/server.js"],
      "@mohasinac/appkit/tokens": ["./node_modules/@mohasinac/appkit/dist/tokens/index.js"],
      "@mohasinac/appkit/tokens/*": ["./node_modules/@mohasinac/appkit/dist/tokens/*"],
      "@mohasinac/appkit/messages/*": ["./node_modules/@mohasinac/appkit/dist/tokens/index.js"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/dev",
    "functions",
    "scripts"
  ]
}
