  "knownGaps": {
    "note": "Subjects deliberately left uncovered, with the reason. Recorded so the next person does not re-derive the search — and so a gap reads as a decision rather than an oversight.",
    "category-burst-bu": "No Takara-Tomy 'Burst Ultimate' wordmark in the mirror. Beyblade_Burst_QuadStrike_Logo.png exists but is Hasbro's contemporaneous line, and no source we hold states the two are the same toyline renamed — so using it as this wave's cover would assert a correspondence nobody confirmed.",
    "category-x-over": "No X-Over Project wordmark in the mirror.",
    "category-metal-phws": "The 2008 Metal System debut has no logo distinct from the Metal Fight Beyblade series mark already used on the generation root; reusing it here would put the same image on parent and child.",
    "category-original-plastic-gen": "Same problem: the only candidate is BeybladeLogo.jpg, already the Original generation root's cover.",
    "category-original-spin-gear": "BB_dual_system_logo.png is the Dual System sub-mark, not the Spin Gear System. Close enough to be tempting and not the same thing.",
    "category-original-hms": "Heavy_Metal_Battle_Logo.jpg names a tournament, not the Heavy Metal System toyline.",
    "non-beyblade-roots": "The five non-Beyblade tier-0 roots (Trading Cards, Collectible Figures, Hot Wheels, Model Kits, Living Collectibles) and the tier-2 band. A root spans many brands, so no single logo represents it honestly — these want original art or a composite, not a borrowed mark.",
    "brand-max-factory": "No freely-licensed logo on en.wikipedia.org or Commons.",
    "brand-megahouse": "No freely-licensed logo on en.wikipedia.org or Commons.",
    "brand-medicom-toy": "No freely-licensed logo on en.wikipedia.org or Commons.",
    "brand-young-toys": "No freely-licensed logo on en.wikipedia.org or Commons.",
    "brand-independent-keepers": "Not a real marque — it groups live-animal and plant sellers, so there is no logo to find.",
    "brand-hot-toys": "No freely-licensed logo on en.wikipedia.org or Commons.",
    "_substring-trap": "🛑 A Commons search for 'Bleach logo' returns Bleacher-report-logo.png — the SPORTS SITE. It passed a naive token test because 'bleach' is a prefix of 'bleacher'. Bleach's logo is taken from bleach.fandom.com instead. Any name-relatedness check here needs whole-word matching, not substring."
  }
}
