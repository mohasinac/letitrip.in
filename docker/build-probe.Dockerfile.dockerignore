# Keep the build context small and, more importantly, keep HOST artefacts out.
#
# 🛑 node_modules especially: the Windows tree carries platform-specific
# binaries (@parcel/watcher, swc, sharp) that are wrong inside a Linux image,
# and a half-working native module fails in ways that look like code bugs.
node_modules
appkit/node_modules
functions/node_modules
tester/node_modules

# Build output — regenerated in the image, and .next from Windows would
# poison the cold-build measurement with a warm cache.
.next
appkit/dist
functions/lib
.build-memory

# 🛑 Secrets must never enter an image LAYER. `COPY . .` would bake .env.local
# and .env.docker-probe into the image, where they survive every later RUN and
# travel with it if it is ever pushed or exported. The build gets its env at
# `docker run` time via --env-file instead, which is process-scoped and leaves
# nothing behind. Nothing at image-build time needs a credential: the appkit
# build and build:css are both offline.
.env
.env.*
tester/.env

# Run artefacts and local state.
.git
.claude
tester/.tester-runs
*.png
*.log
